    "The Old Reader disconnected. Synced feeds remain in Precis." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم قطع اتصال القارئ القديم. تظل الخلاصات المتزامنة في Precis."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরাতন পাঠক সংযোগ বিচ্ছিন্ন. সিঙ্ক করা ফিডগুলি Precis-এ থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der alte Leser wurde getrennt. Synchronisierte Feeds verbleiben in Precis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Viejo Lector se desconectó. Las transmisiones sincronizadas permanecen en Precis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ancien lecteur s'est déconnecté. Les flux synchronisés restent dans Precis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओल्ड रीडर ने संपर्क तोड़ दिया। सिंक की गई फ़ीड प्रीसिस में रहती हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O antigo leitor foi desconectado. Os feeds sincronizados permanecem no Precis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "老读者断线了。同步源保留在 Precis 中。"
          }
        }
      }
    },
    "These %@ feeds and all of their articles will be permanently deleted. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف خلاصات %@ هذه وجميع مقالاتها نهائيًا. لا يمكن التراجع عن هذا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই %@ ফিড এবং তাদের সমস্ত নিবন্ধ স্থায়ীভাবে মুছে ফেলা হবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese %@-Feeds und alle ihre Artikel werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos feeds %@ y todos sus artículos se eliminarán permanentemente. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces flux %@ et tous leurs articles seront définitivement supprimés. Cela ne peut pas être annulé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये %@ फ़ीड और उनके सभी लेख स्थायी रूप से हटा दिए जाएंगे। इसे असंपादित नहीं किया जा सकता है।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses feeds %@ e todos os seus artigos serão excluídos permanentemente. Isto não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些 %@ 提要及其所有文章将被永久删除。此操作无法撤消。"
          }
        }
      }
    },
    "This can take a moment — full text and images are fetched for each article." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يستغرق ذلك بعض الوقت، حيث يتم جلب النص الكامل والصور لكل مقالة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি একটি মুহূর্ত নিতে পারে — প্রতিটি নিবন্ধের জন্য সম্পূর্ণ পাঠ্য এবং চিত্রগুলি আনা হয়৷"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann einen Moment dauern — für jeden Artikel werden Volltext und Bilder abgerufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto puede llevar un momento: se obtienen el texto completo y las imágenes de cada artículo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela peut prendre un moment : le texte intégral et les images sont récupérés pour chaque article."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसमें कुछ समय लग सकता है - प्रत्येक लेख के लिए पूर्ण पाठ और चित्र लाए जाते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso pode demorar um pouco – o texto completo e as imagens são obtidos para cada artigo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这可能需要一些时间——为每篇文章获取全文和图像。"
          }
        }
      }
    },
