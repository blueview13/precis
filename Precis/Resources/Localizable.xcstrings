    "Sync your subscriptions and tags.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步您的订阅和标签。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सदस्यताएँ और टैग सिंक करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus suscripciones y etiquetas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة الاشتراكات والعلامات الخاصة بك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos abonnements et vos tags."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সদস্যতা এবং ট্যাগ সিঙ্ক."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize suas assinaturas e tags."
          }
        }
      }
    },
    "Sync your subscriptions and folders.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步您的订阅和文件夹。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी सदस्यताएँ और फ़ोल्डर्स सिंक करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza tus suscripciones y carpetas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة الاشتراكات والمجلدات الخاصة بك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez vos abonnements et dossiers."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সদস্যতা এবং ফোল্ডার সিঙ্ক করুন."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize suas assinaturas e pastas."
          }
        }
      }
    },
    "Feedbin disconnected. Synced feeds remain in Precis.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进料仓已断开。同步源保留在 Precis 中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ीडबिन डिस्कनेक्ट हो गया. सिंक की गई फ़ीड प्रीसिस में रहती हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedbin desconectado. Las transmisiones sincronizadas permanecen en Precis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قطع اتصال Feedbin. تظل الخلاصات المتزامنة في Precis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corbeille déconnectée. Les flux synchronisés restent dans Precis."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিডবিন সংযোগ বিচ্ছিন্ন। সিঙ্ক করা ফিডগুলি Precis-এ থাকে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedbin desconectado. Os feeds sincronizados permanecem no Precis."
          }
        }
      }
    },
    "The Old Reader disconnected. Synced feeds remain in Precis.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "老读者断线了。同步源保留在 Precis 中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओल्ड रीडर ने संपर्क तोड़ दिया। सिंक की गई फ़ीड प्रीसिस में रहती हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Viejo Lector se desconectó. Las transmisiones sincronizadas permanecen en Precis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قطع اتصال القارئ القديم. تظل الخلاصات المتزامنة في Precis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancien lecteur s'est déconnecté. Les flux synchronisés restent dans Precis."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরাতন পাঠক সংযোগ বিচ্ছিন্ন. সিঙ্ক করা ফিডগুলি Precis-এ থাকে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O antigo leitor foi desconectado. Os feeds sincronizados permanecem no Precis."
          }
        }
      }
    },
    "Newest": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新"
