    "Use your account password. If you sign in with Google or Facebook, set an API password in your account settings first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的帐户密码。如果您使用 Google 或 Facebook 登录，请先在帐户设置中设置 API 密码。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने खाते के पासवर्ड का उपयोग करें. यदि आप Google या Facebook से साइन इन करते हैं, तो पहले अपनी खाता सेटिंग में एक API पासवर्ड सेट करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la contraseña de su cuenta. Si inicia sesión con Google o Facebook, primero establezca una contraseña API en la configuración de su cuenta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم كلمة مرور حسابك. إذا قمت بتسجيل الدخول باستخدام Google أو Facebook، فقم بتعيين كلمة مرور API في إعدادات حسابك أولاً."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le mot de passe de votre compte. Si vous vous connectez avec Google ou Facebook, définissez d'abord un mot de passe API dans les paramètres de votre compte."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অ্যাকাউন্ট পাসওয়ার্ড ব্যবহার করুন. আপনি যদি Google বা Facebook দিয়ে সাইন ইন করেন, তাহলে প্রথমে আপনার অ্যাকাউন্ট সেটিংসে একটি API পাসওয়ার্ড সেট করুন৷"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a senha da sua conta. Se você fizer login no Google ou Facebook, primeiro defina uma senha de API nas configurações da sua conta."
          }
        }
      }
    },
