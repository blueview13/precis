    "Group matching stories among the 800 newest articles into expandable rows.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 800 篇最新文章中的匹配故事分组到可扩展的行中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "800 नवीनतम लेखों के बीच मेल खाती कहानियों को विस्तार योग्य पंक्तियों में समूहित करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe historias coincidentes entre los 800 artículos más nuevos en filas expandibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتجميع القصص المطابقة بين أحدث 800 مقالة في صفوف قابلة للتوسيع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les histoires correspondantes parmi les 800 articles les plus récents dans des lignes extensibles."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্প্রসারণযোগ্য সারিতে 800টি নতুন নিবন্ধের মধ্যে গল্পগুলিকে গোষ্ঠীভুক্ত করুন৷"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe histórias correspondentes entre os 800 artigos mais recentes em linhas expansíveis."
          }
        }
      }
    },
