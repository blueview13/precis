    "- calmer reading\n- less clutter\n- more attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "- 更平静的阅读\n- 更少的混乱\n- 更多的注意力"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "- शांत पठन\n- कम अव्यवस्था\n- अधिक ध्यान"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "- lectura más tranquila\n- menos desorden\n- más atención"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "- قراءة أكثر هدوءًا \n - فوضى أقل \n - مزيد من الاهتمام"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- lecture plus calme\n- moins d'encombrement\n- plus d'attention"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "- শান্ত পড়া \n- কম বিশৃঙ্খল\n- আরও মনোযোগ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "- leitura mais calma\n- menos desordem\n- mais atenção"
          }
        }
      }
    },
    "\"%@\" and all of its articles will be permanently removed. This cannot be undone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其所有文章将被永久删除。此操作无法撤消。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" और इसके सभी लेख स्थायी रूप से हटा दिए जाएंगे। इसे असंपादित नहीं किया जा सकता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y todos sus artículos se eliminarán permanentemente. Esto no se puede deshacer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة \"%@\" وجميع مقالاته نهائيًا. لا يمكن التراجع عن هذا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et tous ses articles seront définitivement supprimés. Cela ne peut pas être annulé."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" এবং এর সমস্ত নিবন্ধ স্থায়ীভাবে মুছে ফেলা হবে৷ এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e todos os seus artigos serão removidos permanentemente. Isto não pode ser desfeito."
          }
        }
      }
    },
